{
  "block": "mlp_b3b_dropout_longo",
  "model": "mlp",
  "k_folds": 5,
  "screening_folds": [
    1,
    2,
    3,
    4,
    5
  ],
  "descricao": "Complementar ao Bloco 3 da MLP: dropout × função de erro com orçamento maior (100 épocas, paciência 10), pois dropout 0,5 atingiu a melhor época perto do limite de 50. Receita fixa = campeão da MLP.",
  "base": {
    "mlp_layers": 4,
    "mlp_neurons": [
      256
    ],
    "activation": "relu",
    "batch_norm": false,
    "optimizer": "adam",
    "lr": 0.0003,
    "momentum": 0.9,
    "weight_decay": 0.0,
    "batch_size": 128,
    "epochs": 100,
    "patience": 10,
    "eval_train": true,
    "seed": 42
  },
  "grid": {
    "dropout": [
      0.2,
      0.5
    ],
    "loss_fn": [
      "cross_entropy",
      "mse"
    ]
  }
}
